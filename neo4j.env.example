# Neo4j AuraDB Free configuration
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_AURA_PASSWORD
NEO4J_DATABASE=neo4j
# When true, Network/graph endpoints return an explicit error if Neo4j is unavailable.
# When false, the backend can fall back to the relational verified graph.
NEO4J_REQUIRED_FOR_GRAPH=true

# Free-tier Gemini model used by CIPHER AI Investigator and evidence extraction
GEMINI_MODEL=gemini-3.6-flash
